# Provider keys — you only need the ones for the models you actually use.
# Model ids follow the Mastra model router format "provider/model": https://mastra.ai/models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Directory kira-code works on. Overrides the default, which is the directory
# you start the CLI in (or this project, under `npm run dev`).
KIRA_PROJECT_DIR=

# Directory scanned for the skills kira-code ships with. Defaults to the skills/
# folder of this project.
KIRA_SKILLS_DIR=

# Your own skills, valid on every project. Defaults to ~/.kira/skills — create
# it yourself; when it is missing the source is simply empty. A project's own
# skills live in <project>/.kira/skills and need no configuration.
KIRA_GLOBAL_SKILLS_DIR=

# MCP servers you want on every project. Defaults to ~/.kira/mcp.json — create it
# yourself; a project can declare its own in <project>/.kira/mcp.json, which stays
# inert until you run /mcp trust.
KIRA_MCP_CONFIG=

# Anthropic prompt cache: off | 5m | 1h. Default 5m. Override per session
# with /cache in the CLI, or with cacheTtl in Studio's request context.
KIRA_CACHE_TTL=

# Project instruction files (AGENTS.md, CLAUDE.md, CONTEXT.md). Set to `off` to
# ignore them entirely — they are instructions written by whoever wrote the
# checkout, which is not always someone you trust.
KIRA_INSTRUCTIONS=

# Model per role. All default to anthropic/claude-haiku-4-5, except
# KIRA_REFLECT_MODEL — see below.
# KIRA_FAST_MODEL is the model the CLI's `fast` mode switches to.
KIRA_MODEL=
KIRA_FAST_MODEL=
KIRA_SUBAGENT_MODEL=
KIRA_MEMORY_MODEL=

# The model that condenses the observation log. Defaults to
# anthropic/claude-sonnet-5, the one role that is not Haiku: a reflection
# rewrites the whole log at once, so whatever it drops is gone for good. Set it
# to anthropic/claude-haiku-4-5 if you want everything cheap.
KIRA_REFLECT_MODEL=

# Context compaction thresholds, in tokens. Left empty they are derived from the
# main model's context window (30% for messages, 20% for observations, floored
# at Mastra's 30k/40k and capped at 150k/100k) — 60000/40000 on Haiku.
# KIRA_OBSERVE_TOKENS is when raw messages become observations,
# KIRA_REFLECT_TOKENS is when the observation log is rewritten.
KIRA_OBSERVE_TOKENS=
KIRA_REFLECT_TOKENS=
